{
  "name": "art-rental",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "http-server": "http-server -c-1 -P http://localhost:8080? dist/art-rental/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "npx serve -s dist/art-rental/browser -l 9000"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ],
    "trailingComma": "none"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@swimlane/ngx-datatable": "^24.0.1",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
